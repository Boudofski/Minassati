NEXT_PUBLIC_SITE_URL=https://minassati.ma

# Analytics — Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Analytics — Vercel Analytics (enabled automatically on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=true

# Lead capture — optional Resend email delivery
# If these are missing, lead forms remain usable and show a mailto fallback.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Minassati Leads <onboarding@resend.dev>"
LEAD_CAPTURE_TO_EMAIL=contact@minassati.ma

# Future API integrations
# NEXT_PUBLIC_QURAN_API_URL=
# NEXT_PUBLIC_AUDIO_API_URL=
